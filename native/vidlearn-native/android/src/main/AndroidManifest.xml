<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ניגון ברקע: שירות קדמה מסוג "ניגון מדיה" + נעילת מעבד, כדי שאנדרואיד לא יקפיא את האפליקציה -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- שמירת עותק בתיקיית ההורדות: באנדרואיד 10 ומטה נדרשת הרשאת כתיבה -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application android:requestLegacyExternalStorage="true">
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- "שיתוף" מיוטיוב / מהדפדפן ← VidLearn: הקישור נפתח במסך ההורדה.
             מתמזג לתוך המסך הראשי של האפליקציה (Capacitor) לפי השם -->
        <activity android:name="com.vidlearn.app.MainActivity" android:exported="true">
            <intent-filter android:label="הורדה ב-VidLearn">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
